{
  "manifest_version": 3,
  "name": "Coverly Artwork Handoff",
  "version": "1.2.0",
  "description": "Attach selected artwork to ChatGPT drafts and return a reference page you select to Coverly for metadata review.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Coverly",
    "default_popup": "popup.html"
  }
}
